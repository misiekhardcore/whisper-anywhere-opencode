{
  "name": "whisper-anywhere-opencode",
  "version": "1.3.2",
  "description": "opencode plugin for whisper-anywhere voice dictation",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "package.json"
  ],
  "keywords": [
    "opencode",
    "plugin",
    "voice",
    "dictation",
    "whisper",
    "local",
    "standalone"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/misiekhardcore/whisper-anywhere-opencode.git"
  },
  "bugs": {
    "url": "https://github.com/misiekhardcore/whisper-anywhere-opencode/issues"
  },
  "homepage": "https://github.com/misiekhardcore/whisper-anywhere-opencode#readme",
  "scripts": {
    "build": "bunx tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.17.4",
    "@types/node": "^25.9.3",
    "bun-types": "^1.3.14",
    "typescript": "^6.0.3"
  },
  "opencode": {
    "type": "plugin",
    "hooks": [
      "chat.message",
      "event"
    ]
  }
}
