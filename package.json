{
  "name": "whisper-anywhere-opencode",
  "version": "1.3.2",
  "description": "opencode plugin for whisper-anywhere voice dictation",
  "type": "module",
  "main": "dist/whisper-anywhere.js",
  "exports": {
    ".": {
      "import": "./dist/whisper-anywhere.js",
      "types": "./whisper-anywhere.ts"
    }
  },
  "files": [
    "dist",
    "whisper-anywhere.ts"
  ],
  "keywords": [
    "opencode",
    "plugin",
    "voice",
    "dictation",
    "whisper"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/misiekhardcore/whisper-anywhere-opencode.git"
  },
  "bugs": {
    "url": "https://github.com/misiekhardcore/whisper-anywhere-opencode/issues"
  },
  "homepage": "https://github.com/misiekhardcore/whisper-anywhere-opencode#readme",
  "scripts": {
    "build": "bun build whisper-anywhere.ts --outdir=dist --target=bun --external='@opencode-ai/plugin' --format=esm",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.17.4",
    "@types/node": "^25.9.3",
    "bun-types": "^1.3.14",
    "typescript": "^6.0.3"
  }
}
